iv> </header> <div><div class="social-icon col-lg-12 col-md-12 col-sm-12"> <div class="col-lg-12 col-md-12 col-sm-12 social-btn" style="padding: 0px"> <ul class="social-img"> <li class="payyourbillbtn" style="text-align: center;"> <a href="https://epayment.dhbvn.org.in/"><img src="/RAPDRP-Redesign-theme/images/img11.png" /></a> <p> <a href="https://epayment.dhbvn.org.in/">Pay Your Bill</a></p> </li> <li class="viewbillbtn"> <a href="https://xyz.dhbvn.org.in/"><img src="/RAPDRP-Redesign-theme/images/img21.PNG" /></a> <p> <a href="https://xyz.dhbvn.org.in/">Theft Information</a></p> </li> <li class="Registerbtn"> <a href="https://ecgrs.dhbvn.org.in/"><img src="/RAPDRP-Redesign-theme/images/img31.PNG" /></a> <p> <a href="https://ecgrs.dhbvn.org.in/">Register Complaints</a></p> </li> <li class="kycnbtn"> <a href="https://dhbvn.org.in/web/portal/update-profile"><img src="/RAPDRP-Redesign-theme/images/img41.PNG" /></a> <p> <a href="https://dhbvn.org.in/web/portal/update-profile">Update KYC</a></p> </li> <li class="newconnectnbtn"> <a href="https://econnection.dhbvn.org.in/"><img src="/RAPDRP-Redesign-theme/images/img51.PNG" /></a> <p style="margin-top:-33px;"> <a href="https://econnection.dhbvn.org.in/">New Connection</a></p> </li> <li class="solarconnectnbtn"> <a href="https://esolarconn.dhbvn.org.in/"><img src="/RAPDRP-Redesign-theme/images/img61.PNG" /></a> <p style="margin-top:-30px;"> <a href="https://esolarconn.dhbvn.org.in/">Solar Connection</a></p> </li> <li class="ViewOutagebtn"> <a href="https://urjamitra.com/app/DiscomDetailsWithMapOutageLink1.html?sid=30&amp;disid=52&amp;disname=DHBVNL"><img src="/RAPDRP-Redesign-theme/images/view_outage.PNG" /></a> <p> <a href="https://urjamitra.com/app/DiscomDetailsWithMapOutageLink1.html?sid=30&amp;disid=52&amp;disname=DHBVNL">View Outages </a></p> </li> <li class="myaccounttnbtn"> <a href="consumer-info"><img src="/RAPDRP-Redesign-theme/images/img81.PNG" /></a> <p> <a href="consumer-info">My Account</a></p> </li> </ul> </div> <!---col-md-12--></div> <!---social-icon--></div> <div id="content"> <div class="portlet-boundary portlet-boundary_103_ portlet-static portlet-static-end " id="p_p_id_103_" > <span id="p_103"></span> <div class="portlet-body"> </div> </div> <div class="columns-1-2-1" id="main-content" role="main"> <div class="portlet-layout"> <div id="contentTop"></div> <div id="content-wrap"> <div id="content" class="container_16 clearfix"> <!-- BEGIN LEFT CONTENT --> <div id="contentLeft" class="grid_10"> <div class="portlet-dropzone portlet-column-content portlet-column-content-only" id="layout-column_column-1"> <div class="portlet-boundary portlet-boundary_LoginApdrp_WAR_Rapdrp_ portlet-static portlet-static-end LoginApdrp-portlet " id="p_p_id_LoginApdrp_WAR_Rapdrp_" > <span id="p_LoginApdrp_WAR_Rapdrp"></span> <div class="portlet-body"> <section class="portlet" id="portlet_LoginApdrp_WAR_Rapdrp"> <header class="portlet-topper"> <h1 class="portlet-title"> <span > <img class="icon" id="owel" src="/Rapdrp/icon.png" alt="" /> </span> <span class="portlet-title-text">LoginApdrp</span> </h1> <menu class="portlet-topper-toolbar" id="portlet-topper-toolbar_LoginApdrp_WAR_Rapdrp" type="toolbar"> </menu> </header> <div class="portlet-content"> <div class=" portlet-content-container" style=""> <div class="portlet-body"> <h2 class='lineHor'>Login</h2> <p style="font-weight:bold;font-size:18px;">This service is for Urban consumers having 10 digits of consumer Account No.</p> <p style=" border-bottom: 2px dotted #928989; width: 703px;" ></p> <!-- BEGIN CONTACT FORM --> <div id="contactForm" class="grid_10"> <form id="loginForm" name="loginForm" action="https://www.dhbvn.org.in/web/portal/auth?p_auth=RJV9ddua&amp;p_p_id=LoginApdrp_WAR_Rapdrp&amp;p_p_lifecycle=1&amp;p_p_state=normal&amp;p_p_mode=view&amp;p_p_col_id=column-1&amp;p_p_col_count=1&amp;_LoginApdrp_WAR_Rapdrp_myaction=loginPage" method="post"> <div id="clientError"> <ul></ul> </div> <p ><input id="accountNo" name="accountNo" class="text_input required" tabindex="1" placeholder="Account No*" type="text" value="" size="10" maxlength="10" alt="accountNo" autocomplete="off"/> <span class="note"> </span> </p> <div id=dispMsg2 style="display:none"> <p style="font-weight: bold; color:red">Please enter correct Account No.</p> </div> <p style="font-weight: bold;"> <input type="checkbox" id="checkBox1"/>&nbsp; Use OTP as password</p><div id=dispMsg1 style="display:none"> <p style="font-weight: bold;padding:2px 30px 2px 150px;color:red">Entered Mobile no. is not registered with us. Please update your mobile no.</p> </div> <div id="pwdBox"> <p><input id="password" name="password" class="text_input required" tabindex="2" placeholder="Password*" type="password" value="" size="15" maxlength="15" alt="password" autocomplete="off"/> </p> </div> <p><input type="submit" value="LOGIN" id="submit" class="button" name="submit" tabindex="3"/></p> <div id=dispMsg4 style="display:none"> <p style="font-weight: bold;">Fetching details please wait..........</p> </div> <div id=dispMsg3 style="display:none"> <br/> <p style="font-weight: bold;">Your registered mobile no is&nbsp;<span id="mobNo"></span></p> <br/> </div> </form> <form id="loginOtpForm" name="loginOtpForm" action="https://www.dhbvn.org.in/web/portal/auth?p_auth=RJV9ddua&amp;p_p_id=LoginApdrp_WAR_Rapdrp&amp;p_p_lifecycle=1&amp;p_p_state=normal&amp;p_p_mode=view&amp;p_p_col_id=column-1&amp;p_p_col_count=1&amp;_LoginApdrp_WAR_Rapdrp_myaction=loginPageOTP" method="post"> <input type="hidden" name="dispFlag"/> <input type="hidden" name="accountNo"/> <p><input type="submit" value="Send OTP" id="submitotp" class="button" name="submitotp" tabindex="3" style="display:none;" onclick="setType('true');" /></p> </form> <div id=showLinks> <p style="font-weight: bold; font-size: 14px;"><label for="name">&nbsp;</label>&nbsp;&nbsp; <a href="registration" tabindex="4">Register Here</a> | <a href="forgot-password" tabindex="5">Forgot Password</a> </p> </div> <p style=" width: 100%; margin-left:0px; color:#000; text-align: left;font-weight: bold; ">In case, you do not have access to your old mobile number, please contact our Customer Care Centre on Toll Free number 1912 or 18001804334 for resetting your account and register afresh.</p> </div> <!-- END CONTACT FORM --> <script language="javascript" type="text/javascript">/*<![CDATA[*/$(function(){$("#accountNo").focus();var c="Enter Account No. in valid format";var a="Enter Password in valid format";var b="Account No. is not in correct format";var d="Password is not in correct format";$.validator.addMethod("loginRegex",function(f,e){return this.optional(e)||/^[0-9]{10}$/i.test(f)});$.validator.addMethod("passwordRegex",function(f,e){return this.optional(e)||/^[^$]{6,15}$/i.test(f)});$(document).ready(function(){$(".dispMsg2").hide();$("#loginForm").submit(function(){$(".errors").hide()});$("#checkBox1").click(function(){$("#dispMsg4").show();$("#submit").hide();$("#showLinks").hide();$("#pwdBox").hide();var e=$("#accountNo").val();if(e==""){$("#submitotp").hide();$("#submit").show();$("#pwdBox").show();$("#dispMsg2").show();$("#dispMsg4").hide();$("#showLinks").show();return false}$.post("/Rapdrp/LoginOTPServlet",{accountNo:e},function(g){var f=new Array();f=g.split("_");if(f[0]!=null){if(f[0]=="BlankAcc"){$("#submitotp").hide();$("#submit").show();$("#pwdBox").show();$("#dispMsg2").show();$("#dispMsg4").hide();$("#showLinks").show();$("#checkBox1").attr("checked",false)}if(f[0]=="mobileNotFound"){$("#submitotp").hide();$("#submit").show();$("#pwdBox").show();$("#dispMsg2").hide();$("#dispMsg1").show();$("#dispMsg4").hide();$("#showLinks").show();$("#checkBox1").attr("checked",false)}if(f[0]=="mobileFound"){$("#mobNo").html(f[1]);$("#submitotp").show();$("#submit").hide();$("#dispMsg3").show();$("#dispMsg2").hide();$("#dispMsg4").hide();$("#showLinks").hide();$("#checkBox1").attr("disabled",true)}}})})})});function setType(a){var b=document.getElementById("accountNo").value;document.forms.loginOtpForm.elements.dispFlag.value=a;var b=document.getElementById("accountNo").value;document.forms.loginOtpForm.elements.accountNo.value=b};/*]]>*/</script> </div> </div> </div> </section> </div> </div> </div> </div> <div id="contentRight" class="grid_5"> <div class="portlet-dropzone portlet-column-content portlet-column-content-only" id="layout-column_column-2"> <div class="portlet-boundary portlet-boundary_56_ portlet-static portlet-static-end portlet-journal-content " id="p_p_id_56_INSTANCE_hDU7fiQTCzX5_" > <span id="p_56_INSTANCE_hDU7fiQTCzX5"></span> <div class="portlet-body"> <section class="portlet" id="portlet_56_INSTANCE_hDU7fiQTCzX5"> <header class="portlet-topper"> <h1 class="portlet-title"> <span > <img class="icon" id="rjus" src="https://www.dhbvn.org.in/RAPDRP-Redesign-theme/images/spacer.png" alt="" style="background-image: url('/html/icons/_sprite.png'); background-position: 50% -496px; background-repeat: no-repeat; height: 16px; width: 16px;" /> </span> <span class="portlet-title-text">Web Content Display</span> </h1> <menu class="portlet-topper-toolbar" id="portlet-topper-toolbar_56_INSTANCE_hDU7fiQTCzX5" type="toolbar"> </menu> </header> <div class="portlet-content"> <div class=" portlet-content-container" style=""> <div class="portlet-body"> <div class="journal-content-article" id="article_10154_10180_10912_1.2"> <p> <a href="faqs" rel="prettyPhoto[mixed]"><img class="imgRight" src="/RapdrpTheme-theme/images/banners/help-login-b.png" style="margin-top: 36px;" /></a></p> <div> &nbsp;</div> <div id="subNavigation"> <h5> Help &amp; FAQs</h5> <ul> <li> <a href="faqs">Help &amp; FAQs</a></li> <li> <a href="contact-us">Contact Us</a></li> <li> <a href="know-your-acc-num">Know You Account Number</a></li> </ul> </div> </div> <div class="entry-links"> </div> </div> </div> </div> </section> </div> </div> </div> </div> </div> </div> </div> <div id="footer-wrap"> <div id="footer" class="container_16 clearfix"></div> <!-- end #footer --> </div> </div> <